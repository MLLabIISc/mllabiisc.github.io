<!-- Partner logos for the home page; the list lives in the `partners:` front matter of _pages/about.md -->
<h2>Our Partners</h2>
<div class="row align-items-center justify-content-center text-center mt-3 mb-3">
  {% for partner in include.partners %}
    <div class="col-4 col-md mb-3">
      <img
        src="{{ partner.logo | prepend: '/assets/img/logos/' | relative_url }}"
        alt="{{ partner.name }}"
        title="{{ partner.name }}"
        class="img-fluid"
        style="max-height: 60px"
      >
    </div>
  {% endfor %}
</div>
